# 播管家独立核销 HTTPS（与金豆 license.sugaiming.com 分离）
# 域名示例：bgj-license.sugaiming.com → 本机 127.0.0.1:8081

server {
    listen 80;
    server_name bgj-license.sugaiming.com;
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name bgj-license.sugaiming.com;

    ssl_certificate     /etc/letsencrypt/live/bgj-license.sugaiming.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bgj-license.sugaiming.com/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
